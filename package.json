{
  "name": "lego-label-search",
  "version": "2.0.0",
  "packageManager": "pnpm@10.27.0",
  "description": "Search for LEGO parts and download printable labels",
  "main": "index.js",
  "scripts": {
    "dev": "node server.js",
    "dev:turbo": "USE_TURBOPACK=true node server.js",
    "dev:no-turbo": "USE_TURBOPACK=false node server.js",
    "build": "next build",
    "deploy": "bash scripts/deploy-production.sh",
    "start": "NODE_ENV=production node server.js",
    "start:next": "NODE_ENV=production next start",
    "lint": "eslint .",
    "db:rebuild": "node scripts/rebuild_database.js",
    "db:migrate": "node scripts/migrations/migrate.js",
    "db:seed": "node scripts/migrations/seed_data.js",
    "db:update": "node scripts/maintenance/update_computed_fields.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "jest tests/api",
    "test:verbose": "jest --verbose",
    "test:debug": "node --inspect-brk ./node_modules/.bin/jest --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdlien/lego-label-search.git"
  },
  "keywords": [
    "lego",
    "parts",
    "search",
    "label",
    "printable"
  ],
  "author": "JD Lien",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jdlien/lego-label-search/issues"
  },
  "homepage": "https://search.brck.ca/",
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "@tailwindcss/postcss": "^4.1.18",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parser": "^3.2.0",
    "heic-convert": "^2.1.0",
    "next": "^16.1.4",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "sharp": "^0.34.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.9",
    "@types/supertest": "^6.0.3",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.4",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "sqlite3"
    ],
    "overrides": {
      "tar": "^7.5.6",
      "undici": "^7.18.2"
    }
  }
}
