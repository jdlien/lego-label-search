{
  "name": "lego-label-search",
  "version": "2.0.0",
  "description": "Search for LEGO parts and download printable labels",
  "main": "index.js",
  "scripts": {
    "dev": "node server.js",
    "dev:turbo": "USE_TURBOPACK=true node server.js",
    "dev:no-turbo": "USE_TURBOPACK=false node server.js",
    "build": "next build",
    "deploy": "bash scripts/deploy-production.sh",
    "start": "NODE_ENV=production node server.js",
    "start:next": "NODE_ENV=production next start",
    "lint": "next lint",
    "db:rebuild": "node scripts/rebuild_database.js",
    "db:migrate": "node scripts/migrations/migrate.js",
    "db:seed": "node scripts/migrations/seed_data.js",
    "db:update": "node scripts/maintenance/update_computed_fields.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "jest tests/api",
    "test:verbose": "jest --verbose",
    "test:debug": "node --inspect-brk ./node_modules/.bin/jest --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdlien/lego-label-search.git"
  },
  "keywords": [
    "lego",
    "parts",
    "search",
    "label",
    "printable"
  ],
  "author": "JD Lien",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jdlien/lego-label-search/issues"
  },
  "homepage": "https://search.brck.ca/",
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.14",
    "@tailwindcss/postcss": "^4.1.7",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parser": "^3.2.0",
    "heic-convert": "^2.1.0",
    "next": "^15.3.2",
    "node-cron": "^4.0.5",
    "postcss": "^8.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "sharp": "^0.34.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "tailwind-variants": "^1.0.0",
    "task-master-ai": "^0.15.0",
    "tw-animate-css": "^1.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.3",
    "@babel/preset-env": "^7.27.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/supertest": "^6.0.3",
    "babel-jest": "^30.0.0-beta.3",
    "eslint": "9.27.0",
    "eslint-config-next": "15.1.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.0-beta.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "supertest": "^7.1.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3"
  }
}
